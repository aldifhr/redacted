# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/tests/
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.auth/

# runtime state (generated, never commit)
/logs/
tests/.last-run.json
tests/.run-log.json

# LLM API key vault (encrypted at rest — never commit)
/logs/keys.vault.json
/logs/vault.key

# skill-install sidecars (generated by `npx skills add`, nested inside installed skills)
.agents/skills/*/.agent/
.agents/skills/*/.agents/
.agents/skills/*/.skillsrc

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# eve agent builds
/.eve/
/.output/
/.skills/
.runs
# typescript
*.tsbuildinfo
next-env.d.ts
